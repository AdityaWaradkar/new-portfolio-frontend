# ============================================
# APPLICATION CONFIGURATION
# ============================================

# App URL (for metadata and canonical URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# API CONFIGURATION
# ============================================

# Backend API URL
# Development: http://localhost:8080
# Production: https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:8080

# ============================================
# OPTIONAL: ANALYTICS & VERIFICATION
# ============================================

# Google Search Console Verification ID (optional)
# Get from: https://search.google.com/search-console
# NEXT_PUBLIC_GOOGLE_VERIFICATION_ID=your-verification-id

# Google Analytics (optional)
# NEXT_PUBLIC_GA_TRACKING_ID=UA-XXXXX-X

# ============================================
# OPTIONAL: FEATURE FLAGS
# ============================================

# Enable/disable features
# NEXT_PUBLIC_ENABLE_ANALYTICS=false
# NEXT_PUBLIC_ENABLE_DEBUG=false

# ============================================
# OPTIONAL: PERFORMANCE
# ============================================

# Enable performance monitoring
# NEXT_PUBLIC_ENABLE_PERFORMANCE_MONITORING=false